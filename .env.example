# Turso cloud database (备用生产环境必需；主生产/本地用下方 DATABASE_URL 走本地 SQLite)
# Get these from https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Local/CI database (主生产 Docker 与本地开发使用；单元测试用临时文件，非 :memory:)
# DATABASE_URL=file:./data/life.db

# App password for login protection (optional — leave empty to disable)
APP_PASSWORD=demo

# Vercel Blob storage for file attachments
# Get from Vercel Dashboard → Storage → Blob → Create store
# Or run: npx vercel env add BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token

# 自托管部署（主生产）配置：见 .env.prod.example 与 DEPLOY.md
# STORAGE_DRIVER=local
# UPLOAD_DIR=/app/data/uploads
# UPLOAD_URL_PREFIX=/uploads
# COOKIE_SECURE=true  # HTTPS 阶段必须为 true（见 .env.prod.example / DEPLOY.md）

# ANALYZE=true          # bundle-analyzer build flag (enabled via npm run analyze)
# BUILD_TARGET=export   # 移动端静态导出构建开关（npm run build:mobile 内部设置，无需手动配置）
# BASE_URL=http://localhost:3000   # Playwright E2E target URL (default when unset)
# NEXT_PUBLIC_ICP_BEIAN=豫ICP备2026036606号-1   # 可选：公网域名部署（ECS Docker）时展示备案号页脚；APK/桌面本地不需要
