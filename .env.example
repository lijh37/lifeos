# ── 数据库：本地 SQLite（默认，本地开发 / 桌面 web 使用）──
# 手机 APK 完全离线，不使用本文件；单元测试用临时文件，非 :memory:
DATABASE_URL=file:./data/lifeos.db

# ── 可选：Turso 远程库（仅 Vercel 备用部署必需）──
# 在 Vercel Dashboard 配置；本地/自托管请勿设置（dev 护栏拒绝连接）
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# ── 登录密码（可选；留空则跳过认证；手机端原生离线模式恒放行）──
APP_PASSWORD=demo

# ── 自托管部署（阿里云 ECS Docker）配置：见 .env.prod.example 与 DEPLOY.md ──
# COOKIE_SECURE=true  # HTTPS 阶段必须为 true（见 .env.prod.example / DEPLOY.md）

# ── 可选：公网域名部署（ECS Docker）时展示备案号页脚；APK/桌面本地不需要 ──
# NEXT_PUBLIC_ICP_BEIAN=豫ICP备2026036606号-1

# ANALYZE=true          # bundle-analyzer build flag (enabled via npm run analyze)
# BUILD_TARGET=export   # 移动端静态导出构建开关（npm run build:mobile 内部设置，无需手动配置）
# BASE_URL=http://localhost:3000   # Playwright E2E target URL (default when unset)
