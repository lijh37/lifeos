# LifeOS 自托管环境变量模板（阿里云 ECS Docker）
# 复制为 .env（或 export 到 shell），docker-compose 会自动读取
# 此文件刻意解耦 Vercel：不设置 TURSO_*，改用本地 SQLite

# ── 数据库：本地 SQLite 文件 ──
# 容器内路径，对应 volume 挂载的 /app/data
DATABASE_URL=file:./data/db/lifeos.db

# ── 登录密码（留空则跳过认证）──
APP_PASSWORD=demo

# HTTPS 阶段必须为 true（Secure cookie 仅在 HTTPS 下回传；http://IP:3000 直连会登录失效）
COOKIE_SECURE=true

# ── 备案号页脚（公网域名部署必需：工信部要求首页底部展示备案号）──
NEXT_PUBLIC_ICP_BEIAN=豫ICP备2026036606号-1

# ── 可选：Turso 远程库（如需切换 Vercel 式远程库时使用）──
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ANALYZE=true          # bundle-analyzer 构建开关（npm run analyze 时启用）
# BASE_URL=http://localhost:3000   # Playwright E2E 目标地址（BASE_URL 不设时用默认）
